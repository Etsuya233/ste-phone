{
  "name": "ste-phone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/watch.ts",
    "sync": "node scripts/sync.ts",
    "deploy:st": "pnpm build && pnpm sync",
    "st:link": "node scripts/link-st.ts",
    "st:unlink": "node scripts/link-st.ts --remove",
    "release:st": "node scripts/release-st.ts",
    "preview:frontend": "node scripts/preview-frontend.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.ts src/data/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "17.9.0",
    "prettier": "^3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
